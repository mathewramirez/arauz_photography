# Copia como .env o define estas variables en Vercel (Settings > Environment Variables)
PORT=3000
ADMIN_PASSWORD=pon-una-contraseña-segura
SESSION_SECRET=un-texto-largo-y-aleatorio

# Solo en Vercel: se crea sola al conectar un Blob Store al proyecto
BLOB_READ_WRITE_TOKEN=

# Solo Railway/servidor propio: carpeta del Volume (ej. /data). En local déjalo vacío.
DATA_DIR=
